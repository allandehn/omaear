# Maintainer: Allan Dehn <allandehn@proton.me>
pkgname=omaear
pkgver=0.4.0
pkgrel=1
pkgdesc="A shelf of podcasts for Omarchy, with playback that keeps going"
arch=('x86_64')
url="https://github.com/allandehn/omaear"
license=('MIT')
depends=(
  'qt6-base'               # Core, Gui, Network, DBus, Sql (+ SQLite driver)
  'qt6-declarative'        # Qml, Quick, Controls (Material), Layouts, Dialogs
  'qt6-multimedia'         # QMediaPlayer, QAudioOutput
  'qt6-multimedia-ffmpeg'  # decoding backend
  'qt6-svg'                # SVG icons (qrc:/icons/*.svg)
  'pipewire'               # mono downmix sink (`pipewire -c`, filter-chain)
  'glibc'
  'gcc-libs'
)
makedepends=() # qmake6, moc, rcc ship with qt6-base
options=('!debug')
optdepends=('libnotify: notice when an old pre-rename instance must be quit first')
# Hand builds and build-local.sh may drop a tarball of this name beside this
# file. scripts/release.sh does not run makepkg in the repo: it archives the
# reviewed commit, writes that checksum into a scratch copy of this file, and
# refuses to package the copy if the checksum line is still a placeholder.
source=("$pkgname-$pkgver.tar.gz::https://github.com/allandehn/omaear/archive/refs/tags/v$pkgver.tar.gz")
sha256sums=('SKIP')
install=omaear.install

build() {
  cd "$pkgname-$pkgver"
  qmake6 PREFIX=/usr CONFIG+=release
  make
}

check() {
  cd "$pkgname-$pkgver"
  QT_QPA_PLATFORM=offscreen ./omaear --self-test
  test "$(./omaear --version)" = "omaear $pkgver"
}

package() {
  cd "$pkgname-$pkgver"
  make INSTALL_ROOT="$pkgdir" install
}
